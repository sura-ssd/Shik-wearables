# Copy this file to .env and fill in the values from Supabase:
# Dashboard > Project Settings > API (or "API Keys").
# Only the project URL and the anon / publishable key belong here.
# NEVER put the service_role key or the Chapa secret key in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
